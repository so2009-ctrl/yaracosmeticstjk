const PHONE="992001991069";
let lang="tg", cart={}, filter="all";
const t=k=>(I18N[lang]&&I18N[lang][k])||k;
const $=s=>document.querySelector(s);

/* ---------- render ---------- */
function renderProducts(){
  const q=($("#searchInput").value||"").trim().toLowerCase();
  const list=PRODUCTS.filter(p=>(filter==="all"||p.size===filter)&&
    (!q||Object.values(p.name).some(n=>n.toLowerCase().includes(q))));
  $("#grid").innerHTML=list.map(p=>`
    <article class="card group bg-white/55 border border-ink/10 p-4 flex flex-col">
      <button class="card-shot relative bg-blush/50 aspect-[4/5] overflow-hidden" data-more="${p.id}" aria-label="${p.name[lang]}">
        <img src="${IMG[p.img]}" alt="${p.name[lang]}" loading="lazy" class="card-img w-full h-full object-contain p-4">
        <span class="absolute top-3 left-3 bg-cream/85 text-[10px] lead uppercase px-2 py-1">${p.vol}</span>
      </button>
      <h3 class="mt-4 font-display text-lg leading-snug">${p.name[lang]}</h3>
      <p class="mt-1 text-[12.5px] text-ink/60">${p.tag[lang]}</p>
      <div class="mt-3 flex items-center justify-between">
        <p class="font-display text-lg">${p.price} <span class="font-sans text-[11px] text-ink/60">${t("cur")}</span></p>
        <button class="text-[11px] lead uppercase text-ink/55 hover:text-gold transition-colors" data-more="${p.id}">${t("cat.more")}</button>
      </div>
      <button class="add-btn btn-outline mt-3 py-2.5 text-[11px] lead uppercase" data-add="${p.id}">${t("cat.add")}</button>
    </article>`).join("");
  $("#noResult").classList.toggle("hidden",list.length>0);
}

function renderGallery(){
  $("#gallery").innerHTML=PRODUCTS.map(p=>`
    <button class="snap-start shrink-0 w-44 sm:w-52 bg-cream border border-ink/10 hover:border-gold transition-colors p-3" data-more="${p.id}">
      <img src="${IMG[p.img]}" alt="${p.name[lang]}" loading="lazy" class="w-full aspect-square object-contain mix-blend-multiply">
      <p class="mt-2 text-[12px] text-ink/70">${p.name[lang]}</p>
    </button>`).join("");
}

function renderCart(){
  const ids=Object.keys(cart); let total=0;
  $("#cartItems").innerHTML = !ids.length
    ? `<p class="text-[14px] text-ink/60">${t("cart.empty")}</p>`
    : ids.map(id=>{ const p=PRODUCTS.find(x=>x.id===id); total+=p.price*cart[id];
        return `<div class="flex gap-4 items-center">
          <img src="${IMG[p.img]}" alt="" class="w-16 h-16 object-contain bg-blush/50 p-1 mix-blend-multiply shrink-0">
          <div class="flex-1"><p class="text-[14.5px]">${p.name[lang]}</p><p class="text-[13px] text-ink/60">${p.price} ${t("cur")}</p></div>
          <div class="flex items-center gap-2 text-sm">
            <button class="w-7 h-7 border border-ink/20 hover:border-gold" data-dec="${id}">−</button>
            <span class="w-5 text-center">${cart[id]}</span>
            <button class="w-7 h-7 border border-ink/20 hover:border-gold" data-inc="${id}">+</button>
          </div></div>`;}).join("");
  if(ids.length) total=ids.reduce((s,id)=>s+PRODUCTS.find(x=>x.id===id).price*cart[id],0);
  $("#cartTotal").textContent=total+" "+t("cur");
  $("#cartCount").textContent=ids.reduce((s,id)=>s+cart[id],0);
  let msg;
  if(!ids.length) msg=t("wa.simple");
  else{
    const lines=ids.map(id=>{const p=PRODUCTS.find(x=>x.id===id);
      return `• ${p.name[lang]} (${p.vol}) × ${cart[id]} — ${p.price*cart[id]} ${t("cur")}`;}).join("\n");
    msg=`${t("wa.hello")}\n${lines}\n${t("wa.total")}: ${total} ${t("cur")}`;
  }
  const url=`https://wa.me/${PHONE}?text=${encodeURIComponent(msg)}`;
  $("#waOrder").href=url; $("#waMain").href=url; $("#waFoot").href=url;
}

function openModal(id){
  const p=PRODUCTS.find(x=>x.id===id); if(!p) return;
  $("#modalImg").innerHTML=`<img src="${IMG[p.img]}" alt="${p.name[lang]}" class="w-full max-h-[52vh] object-contain mix-blend-multiply">`;
  $("#modalBody").innerHTML=`
    <p class="text-[11px] lead uppercase text-gold">${p.tag[lang]}</p>
    <h3 class="mt-3 font-display text-2xl">${p.name[lang]}</h3>
    <p class="mt-2 font-display text-xl">${p.price} <span class="font-sans text-[12px] text-ink/60">${t("cur")}</span></p>
    <div class="mt-6 space-y-4 text-[14px]">
      <div><p class="text-[11px] lead uppercase text-ink/50">${t("notes.top")}</p><p class="mt-1">${p.top[lang]}</p></div>
      <div><p class="text-[11px] lead uppercase text-ink/50">${t("notes.heart")}</p><p class="mt-1">${p.heart[lang]}</p></div>
      <div><p class="text-[11px] lead uppercase text-ink/50">${t("notes.base")}</p><p class="mt-1">${p.base[lang]}</p></div>
      <div><p class="text-[11px] lead uppercase text-ink/50">${t("notes.vol")}</p><p class="mt-1">${p.vol}</p></div>
    </div>
    <button class="btn-gold w-full mt-7 py-3.5 text-[12px] lead uppercase" data-add="${p.id}">${t("cat.add")}</button>`;
  $("#modal").classList.remove("hidden"); $("#modal").classList.add("flex");
}
function closeModal(){ $("#modal").classList.add("hidden"); $("#modal").classList.remove("flex"); }

/* ---------- language ---------- */
function setLang(l){
  lang=I18N[l]?l:"tg";
  document.documentElement.lang=lang;
  document.querySelectorAll("[data-i18n]").forEach(el=>el.textContent=t(el.dataset.i18n));
  document.querySelectorAll("[data-i18n-attr]").forEach(el=>{
    el.dataset.i18nAttr.split(",").forEach(pair=>{const[a,k]=pair.split(":");el.setAttribute(a.trim(),t(k.trim()));});
  });
  document.querySelectorAll(".lang-btn").forEach(b=>b.setAttribute("aria-pressed",String(b.dataset.lang===lang)));
  renderProducts(); renderGallery(); renderCart();
  try{ localStorage.setItem("yara-lang",lang); }catch(e){}
}

let toastTimer;
function toast(txt){
  const el=$("#toast"); el.textContent=txt;
  el.classList.remove("opacity-0","translate-y-4");
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.add("opacity-0","translate-y-4"),2200);
}
function openCart(open){
  $("#drawer").classList.toggle("translate-x-full",!open);
  $("#drawer").setAttribute("aria-hidden",String(!open));
  $("#veil").classList.toggle("opacity-0",!open);
  $("#veil").classList.toggle("pointer-events-none",!open);
}

/* ---------- events ---------- */
document.addEventListener("click",e=>{
  const add=e.target.closest("[data-add]");
  if(add){ const id=add.dataset.add; cart[id]=(cart[id]||0)+1; renderCart();
    toast(`${PRODUCTS.find(x=>x.id===id).name[lang]} — ${t("toast.added")}`); return; }
  const more=e.target.closest("[data-more]");
  if(more){ openModal(more.dataset.more); return; }
  const inc=e.target.closest("[data-inc]"); if(inc){ cart[inc.dataset.inc]++; renderCart(); return; }
  const dec=e.target.closest("[data-dec]");
  if(dec){ const id=dec.dataset.dec; cart[id]--; if(cart[id]<=0) delete cart[id]; renderCart(); return; }
  const chip=e.target.closest("[data-filter]");
  if(chip){ filter=chip.dataset.filter;
    document.querySelectorAll("[data-filter]").forEach(c=>c.setAttribute("aria-pressed",String(c===chip)));
    renderProducts(); return; }
  const lb=e.target.closest(".lang-btn"); if(lb){ setLang(lb.dataset.lang); return; }
  const ml=e.target.closest(".mob-link");
  if(ml){ $("#mobileMenu").classList.add("hidden"); $("#menuToggle").setAttribute("aria-expanded","false"); }
});

$("#cartToggle").addEventListener("click",()=>openCart(true));
$("#drawerClose").addEventListener("click",()=>openCart(false));
$("#veil").addEventListener("click",()=>openCart(false));
$("#modalClose").addEventListener("click",closeModal);
$("#modalVeil").addEventListener("click",closeModal);
document.addEventListener("keydown",e=>{ if(e.key==="Escape"){ openCart(false); closeModal(); }});

$("#menuToggle").addEventListener("click",()=>{
  const open=$("#mobileMenu").classList.toggle("hidden")===false;
  $("#menuToggle").setAttribute("aria-expanded",String(open));
});
$("#searchToggle").addEventListener("click",()=>{
  const bar=$("#searchBar"); bar.classList.toggle("hidden");
  if(!bar.classList.contains("hidden")) $("#searchInput").focus();
});
$("#searchInput").addEventListener("input",renderProducts);

$("#callForm").addEventListener("submit",e=>{
  e.preventDefault(); const f=e.target, note=$("#formNote");
  const ok=f.name.value.trim()&&f.phone.value.trim().length>=6;
  note.textContent=ok?t("form.ok"):t("form.err");
  note.style.color=ok?"#8A7320":"#A8504C";
  note.classList.remove("hidden"); if(ok) f.reset();
});
$("#newsForm").addEventListener("submit",e=>{
  e.preventDefault(); const v=e.target.email.value.trim(), note=$("#newsNote");
  const ok=/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  note.textContent=ok?t("foot.ok"):t("foot.err");
  note.style.color=ok?"#D4AF37":"#E8A9A0";
  note.classList.remove("hidden"); if(ok) e.target.reset();
});

$("#year").textContent=new Date().getFullYear();
let saved="tg"; try{ saved=localStorage.getItem("yara-lang")||"tg"; }catch(e){}
setLang(saved);
</script>
</body>
