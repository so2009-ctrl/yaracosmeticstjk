<style>
  :root{ --cream:#FDFBF7; --blush:#F8E7E1; --gold:#D4AF37; --ink:#2C2C2C; --mist:#F2ECE7; color-scheme:light; }
  @media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --cream:#FDFBF7; --blush:#F8E7E1; --gold:#D4AF37; --ink:#2C2C2C; } }
  :root[data-theme="dark"]{ --cream:#FDFBF7; --blush:#F8E7E1; --gold:#D4AF37; --ink:#2C2C2C; }

  html{ scroll-behavior:smooth; }
  body{ background:var(--cream); color:var(--ink); font-family:Inter,system-ui,sans-serif; overflow-x:hidden; }
  .lead{ letter-spacing:.14em; }
  .rule{ height:1px; background:linear-gradient(90deg,transparent,rgba(212,175,55,.8),transparent); }

  .nav-link{ position:relative; padding-bottom:3px; }
  .nav-link::after{ content:""; position:absolute; left:0; bottom:0; height:1px; width:0; background:var(--gold); transition:width .35s ease; }
  .nav-link:hover::after,.nav-link:focus-visible::after{ width:100%; }

  .btn-gold{ background:var(--ink); color:var(--cream); transition:background .3s,color .3s,transform .3s; }
  .btn-gold:hover{ background:var(--gold); color:#fff; transform:translateY(-2px); }
  .btn-outline{ border:1px solid rgba(44,44,44,.3); transition:border-color .3s,background .3s,color .3s; }
  .btn-outline:hover{ border-color:var(--gold); background:var(--gold); color:#fff; }

  .card{ transition:transform .45s cubic-bezier(.22,.61,.36,1), box-shadow .45s ease, border-color .35s ease; }
  .card:hover{ transform:translateY(-6px); border-color:rgba(212,175,55,.55); box-shadow:0 26px 50px -30px rgba(44,44,44,.5); }
  .card:hover .card-img{ transform:scale(1.07); }
  .card-img{ transition:transform .7s cubic-bezier(.22,.61,.36,1); mix-blend-mode:multiply; }
  .card .add-btn{ opacity:1; }
  @media (min-width:768px){
    .card .add-btn{ opacity:0; transform:translateY(8px); transition:opacity .35s,transform .35s; }
    .card:hover .add-btn,.card:focus-within .add-btn{ opacity:1; transform:none; }
  }

  .chip{ border:1px solid rgba(44,44,44,.18); transition:.3s; }
  .chip[aria-pressed="true"]{ background:var(--ink); color:var(--cream); border-color:var(--ink); }
  .chip:hover{ border-color:var(--gold); }

  .lang-btn{ border-bottom:1px solid transparent; transition:color .25s,border-color .25s; }
  .lang-btn[aria-pressed="true"]{ color:var(--gold); border-bottom-color:var(--gold); }

  .drawer{ transition:transform .45s cubic-bezier(.22,.61,.36,1); }
  .veil,.toast{ transition:opacity .3s ease, transform .3s ease; }
  :focus-visible{ outline:2px solid var(--gold); outline-offset:3px; }

  .gallery{ scrollbar-width:none; }
  .gallery::-webkit-scrollbar{ display:none; }

  @keyframes rise{ from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:none} }
  .rise{ animation:rise 1s cubic-bezier(.22,.61,.36,1) both; }
  @media (prefers-reduced-motion:reduce){ *{animation:none!important;transition-duration:.01ms!important} html{scroll-behavior:auto} }
</style>
</head>
